# Optional: send the contact form to a third-party endpoint (Formspree, Web3Forms, …)
# instead of the built-in Vercel function at /api/contact.
VITE_CONTACT_ENDPOINT=

# Used by /api/contact (set these in Vercel, never commit real values)
RESEND_API_KEY=
CONTACT_TO_EMAIL=kontakt@stronivo.com
CONTACT_FROM_EMAIL="Stronivo <formularz@stronivo.com>"
