# ---- Stroniq (AI assistant) — see STRONIQ.md ----
# Required for the assistant to work. Server-side only (Vercel env), never commit a real key.
ANTHROPIC_API_KEY=
# Optional
STRONIQ_MODEL=claude-opus-5-5
STRONIQ_EFFORT=low
ALLOWED_ORIGINS=https://www.stronivo.com,https://stronivo.com
# Recommended: shared rate limits across function instances (Upstash Redis REST)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Where chat inquiries are delivered (default: the site's Formspree form)
STRONIQ_FORMSPREE_ENDPOINT=https://formspree.io/f/mnpaarla

# ---- Contact form ----
# The form sends to Stronivo's Formspree form by default (https://formspree.io/f/mnpaarla).
# Optional override: another Formspree URL, or "/api/contact" to use the Resend function instead.
VITE_CONTACT_ENDPOINT=

# Used by /api/contact and (if set) by /api/lead instead of Formspree
RESEND_API_KEY=
CONTACT_TO_EMAIL=kontakt@stronivo.com
CONTACT_FROM_EMAIL="Stronivo <formularz@stronivo.com>"
