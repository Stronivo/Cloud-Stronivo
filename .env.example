# Contact form → Formspree (recommended). Paste your form's endpoint, e.g.
# VITE_CONTACT_ENDPOINT=https://formspree.io/f/abcd1234
# Set it in Vercel → Settings → Environment Variables, then redeploy (it is baked in at build time).
VITE_CONTACT_ENDPOINT=

# Alternative: built-in Vercel function /api/contact via Resend (only used when the variable above is empty)
RESEND_API_KEY=
CONTACT_TO_EMAIL=kontakt@stronivo.com
CONTACT_FROM_EMAIL="Stronivo <formularz@stronivo.com>"
